{#
 # SecIncident — onglet Chronologie
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set rand = random() %}
{% set inline_raw = events|length <= 300 %}

<div class="secincident-timeline-tab" id="secincident-timeline-{{ rand }}">

   {% if canedit %}
      <div class="row g-3 mb-3">
         <div class="col-12 col-xxl-7">
            <div class="card h-100 border-blue">
               <div class="card-header">
                  <h3 class="card-title"><i class="ti ti-tool me-2"></i>{{ __('Log an action', 'secincident') }}</h3>
                  <span class="ms-auto text-muted small">{{ __('Investigation or change made by you (outside the EDR\'s automatic actions)', 'secincident') }}</span>
               </div>
               <div class="card-body">
                  <form method="post" action="{{ form_action }}">
                     {{ fields.hiddenField(fk, incident.getID()) }}
                     {{ fields.hiddenField('event_type', 'action') }}
                     <div class="row">
                        {{ fields.datetimeField('date', now, __('Performed on', 'secincident'), {rand: rand, required: true}) }}
                        {{ fields.textField('target', '', __('Target (workstation, server, account…)', 'secincident'), {rand: rand, required: true}) }}
                        {{ fields.dropdownArrayField('tool', 'edr_console', tools, __('Tool / means', 'secincident'), {rand: rand}) }}
                        {{ fields.dropdownArrayField('result', 'ok', results, __('Result', 'secincident'), {rand: rand}) }}
                        {{ fields.textField('name', '', __('What was done', 'secincident'), {rand: rand, required: true, full_width: true,
                           helper: __('E.g.: network isolation of the workstation, account disabled, scheduled task removed…', 'secincident')}) }}
                        {{ fields.textareaField('command', '', __('Exact command / change', 'secincident'), {rand: rand, full_width: true, rows: 2,
                           helper: __('Copy the command, the menu path or the changed setting: this is what makes it possible to redo or undo the action.', 'secincident')}) }}
                        {{ fields.textareaField('content', '', __('Findings / output', 'secincident'), {rand: rand, full_width: true, rows: 2}) }}
                        {{ fields.textField('detection_ref', '', __('EDR detection ref.', 'secincident'), {rand: rand}) }}
                        {% if tasks is not empty %}
                           {{ fields.dropdownArrayField('plugin_secincident_remediationtasks_id', 0, task_choices, __('For the remediation task', 'secincident'), {rand: rand}) }}
                        {% endif %}
                     </div>
                     <div class="d-flex align-items-center">
                        <span class="text-muted small">{{ __('Attach outputs or screenshots in the Documents tab: their SHA-256 is recorded.', 'secincident') }}</span>
                        <button type="submit" name="add" value="1" class="btn btn-primary ms-auto">
                           <i class="ti ti-device-floppy me-1"></i>{{ __('Log', 'secincident') }}
                        </button>
                     </div>
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  </form>
               </div>
            </div>
         </div>
         <div class="col-12 col-xxl-5">
            <details class="card">
               <summary class="card-header cursor-pointer">
                  <h3 class="card-title"><i class="ti ti-plus me-2"></i>{{ __('Other event (note, communication…)', 'secincident') }}</h3>
               </summary>
               <div class="card-body">
                  <form method="post" action="{{ form_action }}">
                     {{ fields.hiddenField(fk, incident.getID()) }}
                     <div class="row">
                        {{ fields.datetimeField('date', now, __('Date'), {rand: rand ~ 'b', required: true}) }}
                        {{ fields.dropdownArrayField('event_type', 'note', types|filter((v, k) => k != 'action'), _n('Type', 'Types', 1), {rand: rand ~ 'b'}) }}
                        {{ fields.textField('name', '', __('Label', 'secincident'), {rand: rand ~ 'b', required: true, full_width: true}) }}
                        {{ fields.textField('hostname', '', __('Host', 'secincident'), {rand: rand ~ 'b'}) }}
                        {{ fields.textField('username', '', __('User involved', 'secincident'), {rand: rand ~ 'b'}) }}
                        {{ fields.textareaField('content', '', __('Detail', 'secincident'), {rand: rand ~ 'b', full_width: true, rows: 3}) }}
                     </div>
                     <div class="text-end">
                        <button type="submit" name="add" value="1" class="btn btn-outline-primary">
                           <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
                        </button>
                     </div>
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                  </form>
               </div>
            </details>
            {% if nb_actions > 0 or nb_remediations > 0 %}
               <a href="{{ print_url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary w-100 mt-3">
                  <i class="ti ti-printer me-1"></i>{{ __('Action and remediation log — print / PDF', 'secincident') }}
               </a>
            {% endif %}
         </div>
      </div>
   {% endif %}

   {% if events is empty %}
      <div class="alert alert-info">{{ __('No event yet.', 'secincident') }}</div>
   {% else %}
      <div class="d-flex flex-wrap gap-1 mb-3 secincident-filters" role="group">
         <button type="button" class="btn btn-sm btn-outline-secondary active" data-filter="">
            {{ __('All', 'secincident') }} ({{ events|length }})
         </button>
         {% for key, label in types %}
            {% set nb = events|filter(e => e.event_type == key)|length %}
            {% if nb > 0 %}
               <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="{{ key }}">
                  {{ label }} ({{ nb }})
               </button>
            {% endif %}
         {% endfor %}
      </div>

      <ul class="secincident-timeline list-unstyled">
         {% for event in events %}
            <li class="secincident-timeline-item" data-type="{{ event.event_type }}">
               <span class="secincident-timeline-dot bg-{{ event.color }} text-white">
                  <i class="{{ event.icon }}"></i>
               </span>
               <div class="card secincident-timeline-card">
                  <div class="card-body py-2">
                     <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted small font-monospace">{{ event.date|formatted_datetime(true) }}</span>
                        <span class="badge bg-{{ event.color }}-lt">{{ event.type_label }}</span>
                        {% if event.source == 'edr' %}
                           <span class="badge bg-red-lt">EDR</span>
                        {% elseif event.source == 'system' %}
                           <span class="badge bg-secondary-lt">{{ __('Automatic', 'secincident') }}</span>
                        {% endif %}
                        <a href="{{ event.form_url }}" class="fw-bold text-reset">{{ event.name }}</a>
                        <span class="ms-auto text-muted small">
                           {% if event.hostname %}<i class="ti ti-device-desktop"></i> {{ event.hostname }}{% endif %}
                           {% if event.username %} <i class="ti ti-user ms-2"></i> {{ event.username }}{% endif %}
                           {% if event.user_name %} <i class="ti ti-pencil ms-2"></i> {{ event.user_name }}{% endif %}
                        </span>
                     </div>
                     {% if event.event_type == 'action' %}
                        <div class="d-flex flex-wrap gap-2 mt-1 small">
                           <span class="badge bg-{{ event.result_color }}-lt">{{ event.result_label }}</span>
                           <span><i class="ti ti-target"></i> {{ event.target }}</span>
                           {% if event.tool_label %}<span class="text-muted"><i class="ti ti-tool"></i> {{ event.tool_label }}</span>{% endif %}
                           {% if event.detection_ref %}<span class="text-muted"><i class="ti ti-radar-2"></i> {{ event.detection_ref }}</span>{% endif %}
                           {% if event.task_name %}<span class="text-muted"><i class="ti ti-list-check"></i> {{ event.task_name }}</span>{% endif %}
                        </div>
                        {% if event.command %}
                           <pre class="secincident-command mt-1 mb-0">{{ event.command }}</pre>
                        {% endif %}
                     {% endif %}
                     {% if event.content %}
                        <div class="mt-1 secincident-pre">{{ event.content|nl2br }}</div>
                     {% endif %}
                     {% if event.has_raw and inline_raw %}
                        <details class="mt-1">
                           <summary class="text-muted small cursor-pointer">{{ __('Imported raw data', 'secincident') }}</summary>
                           <pre class="secincident-raw mt-1 mb-0">{{ event.raw_pretty }}</pre>
                        </details>
                     {% endif %}
                  </div>
               </div>
            </li>
         {% endfor %}
      </ul>
   {% endif %}
</div>

<script>
   (() => {
      const root = document.getElementById('secincident-timeline-{{ rand }}');
      if (!root) {
         return;
      }
      root.querySelectorAll('[data-filter]').forEach((button) => {
         button.addEventListener('click', () => {
            const filter = button.dataset.filter;
            root.querySelectorAll('[data-filter]').forEach((b) => b.classList.toggle('active', b === button));
            root.querySelectorAll('.secincident-timeline-item').forEach((li) => {
               li.classList.toggle('d-none', filter !== '' && li.dataset.type !== filter);
            });
         });
      });
   })();
</script>
