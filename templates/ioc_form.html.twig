{#
 # SecIncident — formulaire d'un indicateur de compromission
 #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set no_inventory_footer = true %}

{% block form_fields %}
   {% set fk = 'plugin_secincident_incidents_id' %}
   {{ fields.hiddenField(fk, item.fields[fk]) }}

   {% if not incident.isNewItem() %}
      {{ fields.htmlField('', incident.getLink(), _n('Security incident', 'Security incidents', 1, 'secincident'), field_options|merge({full_width: true})) }}
   {% endif %}

   {{ fields.dropdownArrayField('ioc_type', item.fields['ioc_type'], types, _n('Type', 'Types', 1), field_options) }}
   {{ fields.dropdownArrayField('verdict', item.fields['verdict'], verdicts, __('Verdict', 'secincident'), field_options) }}
   {{ fields.textareaField('value', item.fields['value'], __('Value', 'secincident'), field_options|merge({full_width: true, rows: 2, required: true})) }}
   {{ fields.datetimeField('date_first_seen', item.fields['date_first_seen'], __('First seen', 'secincident'), field_options) }}
   {{ fields.datetimeField('date_last_seen', item.fields['date_last_seen'], __('Last seen', 'secincident'), field_options) }}
   {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), field_options|merge({full_width: true, rows: 3})) }}

   {% if not item.isNewItem() and item.fields['ioc_type'] in ['sha256', 'sha1', 'md5', 'ipv4', 'domain', 'url'] %}
      <div class="col-12 mt-2">
         <span class="text-muted me-2">{{ __('Search on:', 'secincident') }}</span>
         {% set v = item.fields['value']|url_encode %}
         {% if item.fields['ioc_type'] in ['sha256', 'sha1', 'md5'] %}
            <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="https://www.virustotal.com/gui/file/{{ v }}">VirusTotal</a>
         {% elseif item.fields['ioc_type'] == 'ipv4' %}
            <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="https://www.virustotal.com/gui/ip-address/{{ v }}">VirusTotal</a>
            <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="https://www.abuseipdb.com/check/{{ v }}">AbuseIPDB</a>
         {% elseif item.fields['ioc_type'] == 'domain' %}
            <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="https://www.virustotal.com/gui/domain/{{ v }}">VirusTotal</a>
         {% else %}
            <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="https://urlscan.io/search/#{{ v }}">urlscan.io</a>
         {% endif %}
         <span class="text-muted small ms-2">{{ __('Warning: never submit a confidential file or data to a public service.', 'secincident') }}</span>
      </div>
   {% endif %}
{% endblock %}
