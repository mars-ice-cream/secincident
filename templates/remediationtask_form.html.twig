{#
 # SecIncident — tâche du plan de remédiation
 #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set no_inventory_footer = true %}

{% block form_fields %}
   {% set fk = 'plugin_secincident_incidents_id' %}
   {{ fields.hiddenField(fk, item.fields[fk]) }}
   {% if not incident.isNewItem() %}
      {{ fields.htmlField('', incident.getLink(), _n('Security incident', 'Security incidents', 1, 'secincident'), field_options|merge({full_width: true})) }}
   {% endif %}
   {% if can_plan %}
      {{ fields.dropdownArrayField('phase', item.fields['phase'], phases, __('Phase', 'secincident'), field_options) }}
   {% else %}
      {{ fields.htmlField('', (phases[item.fields['phase']] ?? item.fields['phase'])|e, __('Phase', 'secincident'), field_options) }}
   {% endif %}
   {{ fields.dropdownArrayField('status', item.fields['status'], statuses, __('Status', 'secincident'), field_options) }}
   {% if can_plan %}
      {{ fields.textField('name', item.fields['name'], __('Action', 'secincident'), field_options|merge({required: true, full_width: true})) }}
      {{ fields.textareaField('instructions', item.fields['instructions'], __('Instructions', 'secincident'), field_options|merge({full_width: true, rows: 4})) }}
   {% else %}
      {{ fields.htmlField('', '<strong>' ~ item.fields['name']|e ~ '</strong>', __('Action', 'secincident'), field_options|merge({full_width: true})) }}
      {{ fields.htmlField('', item.fields['instructions']|e|nl2br, __('Instructions', 'secincident'), field_options|merge({full_width: true})) }}
   {% endif %}
   {{ fields.dropdownField('User', 'users_id_assign', item.fields['users_id_assign'], __('Assigned to', 'secincident'), field_options|merge({right: 'own_ticket', entity: incident.fields['entities_id'] ?? 0})) }}
   {% if can_plan %}
      {{ fields.dropdownYesNo('is_mandatory', item.fields['is_mandatory'], __('Mandatory before closure', 'secincident'), field_options) }}
      {{ fields.numberField('position', item.fields['position'], __('Order', 'secincident'), field_options|merge({min: 0, step: 1})) }}
   {% else %}
      {{ fields.htmlField('', item.fields['is_mandatory'] ? __('Yes') : __('No'), __('Mandatory before closure', 'secincident'), field_options) }}
   {% endif %}
   {{ fields.textareaField('comment', item.fields['comment'], __('Report', 'secincident'), field_options|merge({full_width: true, rows: 4})) }}
   {% if item.fields['date_done'] %}
      {{ fields.htmlField('', (item.fields['date_done']|formatted_datetime ~ ' — ' ~ get_item_name('User', item.fields['users_id_done']))|e, __('Performed on', 'secincident'), field_options) }}
   {% endif %}
{% endblock %}
