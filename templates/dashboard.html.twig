{#
 # SecIncident — tableau de bord sécurité
 #}
{% set k = stats.kpi %}

{% macro bars(title, icon, bars) %}
   <div class="card h-100">
      <div class="card-header">
         <h3 class="card-title"><i class="{{ icon }} me-2"></i>{{ title }}</h3>
      </div>
      <div class="card-body">
         {% if bars|filter(b => b.count > 0) is empty %}
            <div class="text-muted">{{ __('No data for the period', 'secincident') }}</div>
         {% else %}
            {% for bar in bars %}
               <a href="{{ bar.url }}" class="d-block text-reset text-decoration-none mb-2">
                  <div class="d-flex justify-content-between small">
                     <span>{{ bar.label }}</span>
                     <strong>{{ bar.count }}</strong>
                  </div>
                  <div class="progress progress-sm">
                     <div class="progress-bar bg-{{ bar.color }}" style="width: {{ bar.percent }}%"
                          role="progressbar" aria-valuenow="{{ bar.percent }}" aria-valuemin="0" aria-valuemax="100"
                          aria-label="{{ bar.label }}"></div>
                  </div>
               </a>
            {% endfor %}
         {% endif %}
      </div>
   </div>
{% endmacro %}

<div class="container-fluid secincident-dashboard">
   <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="mb-0"><i class="ti ti-shield-exclamation me-2"></i>{{ __('Security dashboard', 'secincident') }}</h2>
      <form method="get" class="ms-auto d-flex align-items-center gap-2">
         <label for="secincident-period" class="text-muted small">{{ __('Period', 'secincident') }}</label>
         <select id="secincident-period" name="period" class="form-select form-select-sm" onchange="this.form.submit()">
            {% for days, label in periods %}
               <option value="{{ days }}" {{ days == period ? 'selected' : '' }}>{{ label }}</option>
            {% endfor %}
         </select>
         {% if can_create %}
            <a href="{{ incident_form_url }}" class="btn btn-sm btn-primary"><i class="ti ti-plus me-1"></i>{{ __('New incident', 'secincident') }}</a>
            <a href="{{ import_url }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-file-import me-1"></i>{{ __('CSV import', 'secincident') }}</a>
         {% endif %}
      </form>
   </div>

   <div class="row row-cards mb-3">
      {% set cards = [
         {label: __('Open incidents', 'secincident'), value: k.open, icon: 'ti ti-folder-open', color: 'orange'},
         {label: __('Open with high / critical severity', 'secincident'), value: k.open_critical, icon: 'ti ti-flame', color: 'red'},
         {label: __('Detected in the period', 'secincident'), value: k.new_in_period, icon: 'ti ti-radar-2', color: 'blue'},
         {label: __('Closed in the period', 'secincident'), value: k.closed_period, icon: 'ti ti-circle-check', color: 'green'},
         {label: __('Overdue notifications', 'secincident'), value: k.overdue, icon: 'ti ti-alarm', color: k.overdue > 0 ? 'red' : 'secondary'},
         {label: __('With personal data', 'secincident'), value: k.personal_data, icon: 'ti ti-user-shield', color: 'purple'},
         {label: __('Mean time to contain', 'secincident'), value: k.mttc_hours is null ? '—' : k.mttc_hours ~ ' h', icon: 'ti ti-lock', color: 'yellow'},
         {label: __('Mean time to close', 'secincident'), value: k.mttr_hours is null ? '—' : (k.mttr_hours >= 48 ? (k.mttr_hours / 24)|round(1) ~ ' j' : k.mttr_hours ~ ' h'), icon: 'ti ti-hourglass', color: 'teal'},
      ] %}
      {% for card in cards %}
         <div class="col-6 col-md-4 col-xl-3">
            <div class="card card-sm">
               <div class="card-body d-flex align-items-center">
                  <span class="avatar bg-{{ card.color }}-lt me-3"><i class="{{ card.icon }} fs-2"></i></span>
                  <div>
                     <div class="h2 mb-0">{{ card.value }}</div>
                     <div class="text-muted small">{{ card.label }}</div>
                  </div>
               </div>
            </div>
         </div>
      {% endfor %}
   </div>

   {% if stats.my_tasks is not empty %}
      <div class="card mb-3">
         <div class="card-header">
            <h3 class="card-title"><i class="ti ti-checklist me-2"></i>{{ __('My remediation tasks', 'secincident') }}</h3>
            <span class="badge bg-blue-lt ms-2">{{ stats.my_tasks|length }}</span>
         </div>
         <div class="list-group list-group-flush">
            {% for t in stats.my_tasks %}
               <a href="{{ t.url }}" class="list-group-item list-group-item-action d-flex flex-wrap align-items-center gap-2">
                  <span class="badge bg-{{ t.status_color }}-lt">{{ t.status_label }}</span>
                  <span class="badge bg-{{ t.phase_color }}-lt">{{ t.phase_label }}</span>
                  <strong>{{ t.name }}</strong>
                  {% if t.is_mandatory %}<i class="ti ti-lock text-orange" title="{{ __('Mandatory before closure', 'secincident') }}"></i>{% endif %}
                  <span class="ms-auto text-muted small">{{ t.reference }} — {{ t.incident_name }}</span>
               </a>
            {% endfor %}
         </div>
      </div>
   {% endif %}

   <div class="row row-cards mb-3">
      <div class="col-12 col-lg-6 col-xxl-3">{{ _self.bars(__('By status', 'secincident'), 'ti ti-progress', stats.by_status) }}</div>
      <div class="col-12 col-lg-6 col-xxl-3">{{ _self.bars(__('By severity', 'secincident'), 'ti ti-flame', stats.by_severity) }}</div>
      <div class="col-12 col-lg-6 col-xxl-3">{{ _self.bars(__('By category', 'secincident'), 'ti ti-category', stats.by_category) }}</div>
      <div class="col-12 col-lg-6 col-xxl-3">{{ _self.bars(__('By source', 'secincident'), 'ti ti-plug', stats.by_source) }}</div>
   </div>

   <div class="row row-cards mb-3">
      <div class="col-12 col-lg-6">{{ _self.bars(__('MITRE ATT&CK tactics', 'secincident'), 'ti ti-target-arrow', stats.by_tactic) }}</div>
      <div class="col-12 col-lg-6">{{ _self.bars(__('Most frequent MITRE ATT&CK techniques', 'secincident'), 'ti ti-sword', stats.by_technique) }}</div>
   </div>

   <div class="card mb-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-chart-bar me-2"></i>{{ __('Incidents detected per month (12 months)', 'secincident') }}</h3>
      </div>
      <div class="card-body">
         <div class="secincident-months">
            {% for month, count in stats.months %}
               <div class="secincident-month" title="{{ month }} : {{ count }}">
                  <span class="secincident-month-value small">{{ count > 0 ? count : '' }}</span>
                  <div class="secincident-month-bar bg-primary" style="height: {{ (count * 100 / stats.months_max)|round }}%"></div>
                  <span class="secincident-month-label text-muted small">{{ month|slice(5, 2) }}/{{ month|slice(2, 2) }}</span>
               </div>
            {% endfor %}
         </div>
      </div>
   </div>

   <div class="row row-cards">
      <div class="col-12 col-xl-7">
         <div class="card">
            <div class="card-header">
               <h3 class="card-title"><i class="ti ti-folder-open me-2"></i>{{ __('Open incidents', 'secincident') }}</h3>
            </div>
            <div class="table-responsive">
               <table class="table table-vcenter card-table table-sm">
                  <thead>
                     <tr>
                        <th>{{ __('Reference', 'secincident') }}</th>
                        <th>{{ __('Title', 'secincident') }}</th>
                        <th>{{ __('Severity', 'secincident') }}</th>
                        <th>{{ __('Status', 'secincident') }}</th>
                        <th>{{ __('Age', 'secincident') }}</th>
                     </tr>
                  </thead>
                  <tbody>
                     {% for i in stats.open_list %}
                        <tr>
                           <td class="text-nowrap"><a href="{{ i.url }}">{{ i.reference }}</a></td>
                           <td><a href="{{ i.url }}" class="text-reset">{{ i.name }}</a><div class="text-muted small">{{ i.category }}</div></td>
                           <td><span class="badge bg-{{ i.severity_color }}-lt">{{ i.severity_label }}</span></td>
                           <td><span class="badge bg-{{ i.status_color }}-lt">{{ i.status }}</span></td>
                           <td class="text-nowrap">{{ i.age_days is null ? '—' : i.age_days ~ ' j' }}</td>
                        </tr>
                     {% else %}
                        <tr><td colspan="5" class="text-muted">{{ __('No open incident', 'secincident') }}</td></tr>
                     {% endfor %}
                  </tbody>
               </table>
            </div>
         </div>
      </div>
      <div class="col-12 col-xl-5">
         <div class="card">
            <div class="card-header">
               <h3 class="card-title"><i class="ti ti-gavel me-2"></i>{{ __('Regulatory notifications to follow up', 'secincident') }}</h3>
            </div>
            <div class="list-group list-group-flush">
               {% for d in stats.deadlines %}
                  <a href="{{ d.incident_url }}" class="list-group-item list-group-item-action">
                     <div class="d-flex justify-content-between">
                        <strong>{{ d.label }}</strong>
                        {% if d.state == 'overdue' %}
                           <span class="badge bg-red-lt">{{ __('Overdue', 'secincident') }}</span>
                        {% elseif d.state == 'pending' %}
                           <span class="badge bg-yellow-lt">{{ d.remaining }} h</span>
                        {% else %}
                           <span class="badge bg-secondary-lt">{{ __('Awareness date missing', 'secincident') }}</span>
                        {% endif %}
                     </div>
                     <div class="text-muted small">
                        {{ d.incident_ref }} — {{ d.incident_name }}
                        {% if d.due %} · {{ __('deadline', 'secincident') }} {{ d.due|formatted_datetime }}{% endif %}
                     </div>
                  </a>
               {% else %}
                  <div class="list-group-item text-muted">{{ __('Nothing to report', 'secincident') }}</div>
               {% endfor %}
            </div>
         </div>
      </div>
   </div>
</div>
