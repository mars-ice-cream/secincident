#: src/Playbook.php:200
#, php-format
msgid "%d step"
msgid_plural "%d steps"
msgstr[0] "%d étape"
msgstr[1] "%d étapes"

#: src/Playbook.php:30 templates/playbookstep_form.html.twig:13
msgid "Remediation playbook"
msgid_plural "Remediation playbooks"
msgstr[0] "Procédure de remédiation"
msgstr[1] "Procédures de remédiation"

#: src/Playbook.php:326
msgid "Data encryption, ransom note, deletion of shadow copies."
msgstr "Chiffrement de données, note de rançon, suppression des clichés instantanés."

#: src/Playbook.php:328
msgid "Isolate the affected workstations and servers"
msgstr "Isoler les postes et serveurs touchés"

#: src/Playbook.php:328
msgid "Isolate from the network (network containment from the EDR console, or cable/Wi-Fi cut). Do NOT shut the machines down: memory may hold keys and traces."
msgstr "Isoler du réseau (confinement réseau depuis la console EDR, ou câble/Wi-Fi coupé). Ne PAS éteindre les machines : la mémoire peut contenir des clés et des traces."

#: src/Playbook.php:329
msgid "Cut remote access"
msgstr "Couper les accès distants"

#: src/Playbook.php:329
msgid "Suspend VPN, exposed RDP, provider access and network shares while the scope is being assessed."
msgstr "Suspendre VPN, RDP exposés, accès prestataires et partages réseau le temps de qualifier le périmètre."

#: src/Playbook.php:330
msgid "Disable the compromised accounts"
msgstr "Désactiver les comptes compromis"

#: src/Playbook.php:330
msgid "Disable the accounts used by the attacker and revoke their sessions and tokens."
msgstr "Désactiver les comptes utilisés par l'attaquant et révoquer leurs sessions et jetons."

#: src/Playbook.php:331 src/Playbook.php:393
msgid "Preserve the evidence"
msgstr "Préserver les preuves"

#: src/Playbook.php:331
msgid "Export EDR detections, Windows/firewall/proxy logs, memory capture if possible. Attach the files to the incident (Documents tab): their SHA-256 is recorded."
msgstr "Exporter les détections EDR, journaux Windows/pare-feu/proxy, capture mémoire si possible. Joindre les fichiers à l'incident (onglet Documents) : leur SHA-256 est enregistré."

#: src/Playbook.php:332
msgid "Determine the scope"
msgstr "Déterminer le périmètre"

#: src/Playbook.php:332
msgid "Search for the same hash / command line across the whole fleet (EDR console), list the affected hosts and accounts and link the computers to the incident."
msgstr "Rechercher le même hash / la même ligne de commande sur tout le parc (console EDR), lister les hôtes et comptes touchés et lier les ordinateurs à l'incident."

#: src/Playbook.php:333
msgid "Check the state of the backups"
msgstr "Vérifier l'état des sauvegardes"

#: src/Playbook.php:333
msgid "Confirm that a clean backup — offline or immutable, prior to the compromise — exists and can be restored."
msgstr "Confirmer qu'une sauvegarde saine, hors ligne ou immuable, antérieure à la compromission existe et est restaurable."

#: src/Playbook.php:334 src/Playbook.php:369
msgid "Assess GDPR / NIS2 obligations"
msgstr "Évaluer les obligations RGPD / NIS2"

#: src/Playbook.php:334
msgid "Fill in the GDPR / NIS2 tab (72 h CNIL, 24 h / 72 h ANSSI where applicable)."
msgstr "Renseigner l'onglet RGPD / NIS2 (72 h CNIL, 24 h / 72 h ANSSI le cas échéant)."

#: src/Playbook.php:335
msgid "File a complaint and inform"
msgstr "Déposer plainte et informer"

#: src/Playbook.php:335
msgid "Complaint (police, online), cyber insurer, management. Resources: cybermalveillance.gouv.fr. Do not pay the ransom without legal advice."
msgstr "Plainte (police, gendarmerie ou en ligne), assureur cyber, direction. Ressources : cybermalveillance.gouv.fr. Ne pas payer la rançon sans avis juridique."

#: src/Playbook.php:336
msgid "Identify and close the initial vector"
msgstr "Identifier et fermer le vecteur initial"

#: src/Playbook.php:336
msgid "Phishing, exposed RDP, unpatched vulnerability, provider account… Fix it before any return to service."
msgstr "Hameçonnage, RDP exposé, vulnérabilité non corrigée, compte prestataire… Corriger avant toute remise en service."

#: src/Playbook.php:337
msgid "Remove persistence"
msgstr "Supprimer la persistance"

#: src/Playbook.php:337
msgid "Scheduled tasks, services, Run keys, modified GPOs, accounts added by the attacker."
msgstr "Tâches planifiées, services, clés Run, GPO modifiées, comptes ajoutés par l'attaquant."

#: src/Playbook.php:338
msgid "Reset passwords"
msgstr "Réinitialiser les mots de passe"

#: src/Playbook.php:338
msgid "All privileged accounts, service accounts, and the krbtgt account twice if Active Directory is affected."
msgstr "Tous les comptes à privilèges, comptes de service, et deux fois le compte krbtgt si l'Active Directory est touché."

#: src/Playbook.php:339
msgid "Restore from a clean backup"
msgstr "Restaurer depuis une sauvegarde saine"

#: src/Playbook.php:339
msgid "Reinstall or restore the systems, check for the absence of indicators (incident IOCs) before reconnecting."
msgstr "Réinstaller ou restaurer les systèmes, vérifier l'absence d'indicateurs (IOC de l'incident) avant reconnexion."

#: src/Playbook.php:340
msgid "Return to service under monitoring"
msgstr "Remettre en service sous surveillance"

#: src/Playbook.php:340
msgid "Reconnect step by step, with reinforced EDR monitoring for at least 2 weeks."
msgstr "Reconnecter par étapes, surveillance EDR renforcée pendant au moins 2 semaines."

#: src/Playbook.php:341 src/Playbook.php:370 src/Playbook.php:397 templates/incident_form.html.twig:141
msgid "Lessons learned"
msgstr "Retour d'expérience"

#: src/Playbook.php:341
msgid "Root cause and corrective actions in the incident form, update this playbook if needed."
msgstr "Cause racine et actions correctives dans la fiche incident, mise à jour de cette procédure si besoin."

#: src/Playbook.php:345
msgid "Phishing"
msgstr "Hameçonnage"

#: src/Playbook.php:347
msgid "Fraudulent e-mail received, link clicked or credentials entered."
msgstr "Courriel frauduleux reçu, lien cliqué ou identifiants saisis."

#: src/Playbook.php:349
msgid "Retrieve the original message"
msgstr "Récupérer le message d'origine"

#: src/Playbook.php:349
msgid "Obtain the full e-mail (.eml with headers) and attach it to the incident."
msgstr "Obtenir le courriel complet (.eml avec en-têtes) et le joindre à l'incident."

#: src/Playbook.php:350
msgid "Block the sender, links and domains"
msgstr "Bloquer l'expéditeur, les liens et les domaines"

#: src/Playbook.php:350
msgid "Mail gateway, proxy / DNS filtering, firewall. Add the URLs and domains as IOCs."
msgstr "Messagerie, proxy / DNS filtrant, pare-feu. Ajouter les URL et domaines en IOC."

#: src/Playbook.php:351
msgid "Purge the message from other mailboxes"
msgstr "Purger le message des autres boîtes"

#: src/Playbook.php:351
msgid "Find and delete the same message for all recipients."
msgstr "Rechercher et supprimer le même message chez tous les destinataires."

#: src/Playbook.php:352
msgid "Identify the users who clicked or entered credentials"
msgstr "Identifier les utilisateurs ayant cliqué ou saisi des identifiants"

#: src/Playbook.php:352
msgid "Proxy / mail logs, talks with the recipients. Link the users involved."
msgstr "Journaux proxy / messagerie, échanges avec les destinataires. Lier les utilisateurs concernés."

#: src/Playbook.php:353
msgid "Reset the exposed credentials"
msgstr "Réinitialiser les identifiants exposés"

#: src/Playbook.php:353
msgid "Change passwords, revoke sessions, check mailbox forwarding and access rules."
msgstr "Changer les mots de passe, révoquer les sessions, vérifier les règles de transfert et d'accès à la boîte."

#: src/Playbook.php:354
msgid "Analyse the workstations involved"
msgstr "Analyser les postes concernés"

#: src/Playbook.php:354
msgid "Full EDR scan if an attachment was opened."
msgstr "Scan EDR complet si une pièce jointe a été ouverte."

#: src/Playbook.php:355
msgid "Assess GDPR obligations"
msgstr "Évaluer les obligations RGPD"

#: src/Playbook.php:355
msgid "If personal data may have been exposed, fill in the GDPR / NIS2 tab."
msgstr "Si des données personnelles ont pu être exposées, renseigner l'onglet RGPD / NIS2."

#: src/Playbook.php:356
msgid "Raise awareness"
msgstr "Sensibiliser"

#: src/Playbook.php:356
msgid "Feedback to the users involved, reminder of the signs of phishing."
msgstr "Retour aux utilisateurs concernés, rappel des signes d'un hameçonnage."

#: src/Playbook.php:362
msgid "Illegitimate sign-in, credential theft, privilege escalation."
msgstr "Connexion illégitime, vol d'identifiants, élévation de privilèges."

#: src/Playbook.php:364
msgid "Block the account and revoke sessions"
msgstr "Bloquer le compte et révoquer les sessions"

#: src/Playbook.php:364
msgid "Disable or reset the account, revoke tokens and active sessions (mail, VPN, cloud)."
msgstr "Désactiver ou réinitialiser le compte, révoquer jetons et sessions actives (messagerie, VPN, cloud)."

#: src/Playbook.php:365
msgid "Trace the account's activity"
msgstr "Retracer l'activité du compte"

#: src/Playbook.php:365
msgid "Sign-ins (dates, IP, country), actions performed, data viewed or exported. Attach the logs."
